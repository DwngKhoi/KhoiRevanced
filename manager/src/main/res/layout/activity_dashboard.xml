<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070910"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="KHOI REVANCED"
            android:textColor="#FF22E6FF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="LAUNCH&#10;MATRIX"
            android:textColor="#FFF5F7FA"
            android:textSize="40sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="22dp"
            android:background="#FFFF3F9F" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Choose a target. The manager starts the stock app, injects the root runtime, and returns you to the target when it is ready."
            android:textColor="#FF9AA8B3"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/cyber_panel_round"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SUPPORTED TARGETS"
                android:textColor="#FFFF3F9F"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <Button
                android:id="@+id/launch_youtube"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/cyber_button_round"
                android:text="LAUNCH  •  YOUTUBE"
                android:textColor="#FF05070D"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/shortcut_youtube"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/cyber_button_outline"
                android:text="ADD YOUTUBE SHORTCUT"
                android:textColor="#FF22E6FF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/launch_music"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/cyber_button_pink"
                android:text="LAUNCH  •  YOUTUBE MUSIC"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/shortcut_music"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/cyber_button_outline"
                android:text="ADD MUSIC SHORTCUT"
                android:textColor="#FF22E6FF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/launch_photos"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/cyber_button_dark"
                android:text="LAUNCH  •  GOOGLE PHOTOS"
                android:textColor="#FFD6F8FF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/shortcut_photos"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/cyber_button_outline"
                android:text="ADD PHOTOS SHORTCUT"
                android:textColor="#FF22E6FF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/cyber_panel"
            android:padding="14dp"
            android:text="Standalone mode • no LSPosed installation • root manager authorization required"
            android:textColor="#FF71818A"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
