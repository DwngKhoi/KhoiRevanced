<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#05070D">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <View android:layout_width="match_parent" android:layout_height="2dp" android:background="#FF00E5FF" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="// KHOI REVANCED" android:textColor="#FF00E5FF" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="APP MANAGER" android:textColor="#FFFFFFFF" android:textSize="30sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Enable a target to request its live launcher icon." android:textColor="#FF94AAB0" android:textSize="13sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:background="@drawable/cyber_panel" android:orientation="vertical" android:padding="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TARGET PROFILES" android:textColor="#FFFF4FA3" android:textSize="12sp" android:textStyle="bold" />
            <Switch android:id="@+id/toggle_youtube" android:layout_width="match_parent" android:layout_height="56dp" android:text="YouTube" android:textColor="#FFFFFFFF" android:textSize="18sp" />
            <Switch android:id="@+id/toggle_music" android:layout_width="match_parent" android:layout_height="56dp" android:text="YouTube Music" android:textColor="#FFFFFFFF" android:textSize="18sp" />
            <Switch android:id="@+id/toggle_photos" android:layout_width="match_parent" android:layout_height="56dp" android:text="Google Photos" android:textColor="#FFFFFFFF" android:textSize="18sp" />
        </LinearLayout>
        <Button android:id="@+id/launch_youtube" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="26dp" android:background="@drawable/cyber_button" android:text="LAUNCH YOUTUBE NOW" android:textColor="#FF05070D" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Each enabled target asks the launcher to pin a shortcut using the app's current system icon." android:textColor="#FF65747A" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
