<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05070D"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="// KHOI REVANCED" android:textColor="#FF00E5FF" android:textSize="14sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="INJECTION SEQUENCE" android:textColor="#FFFFFFFF" android:textSize="28sp" android:textStyle="bold" />
    <View android:layout_width="match_parent" android:layout_height="2dp" android:layout_marginTop="16dp" android:background="#FFFF4FA3" />
    <ImageView android:layout_width="100dp" android:layout_height="100dp" android:layout_marginTop="46dp" android:background="@drawable/icon_round_black" android:contentDescription="KhoiRevanced" android:padding="8dp" android:src="@drawable/khoirevanced_icon" />
    <ProgressBar android:id="@+id/loading_progress" style="?android:attr/progressBarStyleLarge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="34dp" android:indeterminateTint="#FF00E5FF" />
    <TextView android:id="@+id/loading_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:background="@drawable/cyber_panel" android:gravity="center" android:padding="18dp" android:textColor="#FFBCECF2" android:textSize="13sp" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="DO NOT CLOSE THIS WINDOW" android:textColor="#FFFF4FA3" android:textSize="11sp" />
</LinearLayout>
