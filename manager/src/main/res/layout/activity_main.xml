<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="28dp">
    <ImageView
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:background="@drawable/icon_round_black"
        android:contentDescription="KhoiRevanced"
        android:padding="8dp"
        android:src="@drawable/khoirevanced_icon" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="KhoiRevanced"
        android:textColor="#FFFFFFFF"
        android:textSize="28sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="forked from NexAlloy"
        android:textColor="#FFB8B8C8"
        android:textSize="14sp" />
    <Button android:id="@+id/root_check" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="34dp" android:text="Kiểm tra quyền root" />
    <Button android:id="@+id/launch_youtube" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Inject và mở YouTube" />
    <Button android:id="@+id/runtime_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Trạng thái runtime" />
    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:background="#FF17151A"
        android:padding="16dp"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp" />
</LinearLayout>
