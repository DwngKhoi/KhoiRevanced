# Android's /system/bin/sh rejects CRLF: a script checked out with CRLF fails
# with "set: Illegal option -\r" the moment it runs as root on device.
# Force LF for every shell script in the repository so the packaged runtime is
# correct regardless of the contributor's core.autocrlf setting.
*.sh text eol=lf

# Keep the vendored prebuilt binaries and jars untouched.
*.so binary
*.a binary
*.jar binary
*.aar binary
*.apk binary
*.zip binary
*.jks binary
*.keystore binary

# Image and documentation assets.
*.png binary
*.jpg binary
*.webp binary
*.gif binary

# Gradle/Kotlin/Java sources default to LF too; normalize to avoid noisy diffs.
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.md text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.toml text eol=lf
*.properties text eol=lf
